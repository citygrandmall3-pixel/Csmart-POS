async function getSaleProductPrice(productId, unitId) {
    const select = document.getElementById("currencyId");
    const currencyId = Number(
        (currentSale && currentSale.currency_id) ||
        (select && select.value) || 0
    );

    if (!currencyId) {
        return {found: false, price: 0, reason: "عملة الفاتورة غير محددة"};
    }

    const params = new URLSearchParams({
        product_id: String(productId),
        unit_id: String(unitId),
        currency_id: String(currencyId),
        price_type: "sale"
    });

    const result = await api(`/api/product-prices/lookup?${params.toString()}`);
    return {
        found: Boolean(result && result.found),
        price: Number(result && result.price || 0),
        reason: result && result.found ? "" : "لا يوجد سعر بيع مسجل لهذه الوحدة والعملة"
    };
}

async function ensurePosDraft() {
    if (currentSale) {
        if (currentSale.status === "draft") return currentSale;
        throw new Error("الفاتورة الحالية معتمدة. ابدأ فاتورة جديدة أولًا.");
    }
    const currencySelect = document.getElementById("currencyId");
    const baseOption = currencySelect.querySelector("[data-is-base=\"1\"]");
    const firstOption = Array.from(currencySelect.options).find(option => option.value !== "");
    const currencyId = currencySelect.value || (baseOption ? baseOption.value : "") || (firstOption ? firstOption.value : "");
    const payload = {
        customer_id: document.getElementById("customerId").value || null,
        warehouse_id: document.getElementById("warehouseId").value || posDefaultWarehouseId || null,
        customer_invoice_no: document.getElementById("customerInvoiceNo").value || "",
        invoice_date: document.getElementById("invoiceDate").value || today(),
        currency_id: currencyId || null,
        exchange_rate: Number(document.getElementById("exchangeRate").value || 1),
        payment_method: document.getElementById("paymentMethod").value || "cash",
        notes: document.getElementById("notes").value || ""
    };
    const data = await api("/api/sales", {method: "POST", body: JSON.stringify(payload)});
    document.getElementById("saleId").value = data.sale_id;
    document.getElementById("invoiceNo").value = data.invoice_no;
    await loadSales();
    await openSale(data.sale_id);
    if (!currentSale || currentSale.status !== "draft") throw new Error("تعذر فتح مسودة البيع الجديدة.");
    return currentSale;
}

async function addCatalogProduct(productId) {
    const product = productsCache.find(p => Number(p.id) === Number(productId));
    if (!product) {
        setCatalogMessage("الصنف غير موجود في قائمة الأصناف.", false);
        return;
    }

    const unitId = Number(product.base_unit_id || 0);
    if (!unitId) {
        setCatalogMessage(`لم يتم تحديد الوحدة الأساسية للصنف ${product.name}.`, false);
        return;
    }

    const _sr = stockBalancesCache.find(x => Number(x.product_id) === Number(productId)); const _sq = Number(_sr ? _sr.quantity : 0); if (_sq <= 0) { const _pn = (productsCache.find(p => Number(p.id) === Number(productId)) || {}).name || productId; setCatalogMessage("لا يوجد رصيد من الصنف " + _pn + " في المخزن الافتراضي.", false); return; } document.querySelectorAll(".pos-product-card").forEach(b => b.disabled = true);

    try {
        if (!currentSale || currentSale.status !== "draft") {
            await ensurePosDraft();
        }
        if (!currentSale || currentSale.status !== "draft" || !currentSale.id) {
            throw new Error("تعذر تجهيز مسودة البيع لإضافة الصنف.");
        }
        const saleId = currentSale.id;

        const existing = Array.isArray(currentSale.items)
            ? currentSale.items.find(x =>
                Number(x.product_id) === Number(productId) &&
                Number(x.unit_id) === unitId
            )
            : null;

        if (existing) {
            const quantity = Number(existing.quantity || 0) + 1;
            await api(`/api/sales/${saleId}/items/${existing.id}`, {
                method: "PUT",
                body: JSON.stringify({
                    product_id: Number(productId),
                    unit_id: unitId,
                    quantity,
                    unit_price: Number(existing.unit_price || 0),
                    discount: Number(existing.discount || 0),
                    tax_rate: Number(existing.tax_rate || 0),
                    notes: existing.notes || ""
                })
            });
            setCatalogMessage(`تمت زيادة كمية ${product.name} إلى ${quantity}.`);
        } else {
            const price = await getSaleProductPrice(productId, unitId);
            await api(`/api/sales/${saleId}/items`, {
                method: "POST",
                body: JSON.stringify({
                    product_id: Number(productId),
                    unit_id: unitId,
                    quantity: 1,
                    unit_price: price.price,
                    discount: 0,
                    tax_rate: 0,
                    notes: ""
                })
            });

            setCatalogMessage(
                price.found
                    ? `تمت إضافة ${product.name} بسعر ${fmt(price.price)}.`
                    : `تمت إضافة ${product.name} بسعر صفر لعدم وجود سعر مسجل. عدّل السعر قبل اعتماد الفاتورة.`,
                Boolean(price.found)
            );
        }

        await loadSales();
        await openSale(saleId);
    } catch (e) {
        setCatalogMessage(e.message || "تعذرت إضافة الصنف.", false);
    } finally {
        document.querySelectorAll(".pos-product-card").forEach(b => b.disabled = false);
    }
}


function showAddItem() {
