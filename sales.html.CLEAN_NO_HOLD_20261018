                stockBalancesCache = rowsOf(stockBalances);
            } catch (e) {
                stockBalancesCache = [];
            }
        }
        if (defaultWarehouseId && whs.some(w => String(w.id) === String(defaultWarehouseId) && w.is_active !== 0)) {
            document.getElementById("warehouseId").value = String(defaultWarehouseId);
        }

        const currs = rowsOf(currencies);
        document.getElementById("currencyId").innerHTML =
            `<option value="">اختر العملة</option>` +
            currs.map(x =>
                `<option value="${x.id}" data-is-base="${Number(x.is_base) === 1 ? '1' : '0'}">${escapeHtml(x.code || '')} - ${escapeHtml(x.name || '')}</option>`
            ).join("");

        productsCache = rowsOf(products).filter(x =>
            x.is_active !== 0 && x.is_stock_item !== 0
        );

        unitsCache = rowsOf(units).filter(x => x.is_active !== 0);

        document.getElementById("itemProductId").innerHTML =
            `<option value="">اختر الصنف</option>` +
            productsCache.map(x =>
                `<option value="${x.id}" data-unit="${x.base_unit_id || ''}">${escapeHtml(x.code || '')} - ${escapeHtml(x.name || '')}</option>`
            ).join("");

        document.getElementById("itemUnitId").innerHTML =
            `<option value="">اختر الوحدة</option>` +
            unitsCache.map(x =>
                `<option value="${x.id}">${escapeHtml(x.code || '')} - ${escapeHtml(x.name || '')}</option>`
            ).join("");

        document.getElementById("itemProductId").onchange = function() {
            const opt = this.options[this.selectedIndex];
            const unitId = opt?.dataset?.unit;
            if (unitId) {
                document.getElementById("itemUnitId").value = unitId;
            }
        };

    } catch(e) {
        showMessage("فشل تحميل بيانات الاختيار: " + e.message, false);
    }
}

