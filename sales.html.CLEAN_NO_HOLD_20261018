    editingItemId = null;

    document.getElementById("itemProductId").value = "";
    document.getElementById("itemUnitId").value = "";
    document.getElementById("itemQuantity").value = "1";
    document.getElementById("itemUnitPrice").value = "0";
    document.getElementById("itemDiscount").value = "0";
    document.getElementById("itemTaxRate").value = "0";
    document.getElementById("itemNotes").value = "";

    document.getElementById("itemForm").style.display = "";
}

function cancelItemEdit() {
