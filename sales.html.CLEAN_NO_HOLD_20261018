async function saveSale(event) {
    event.preventDefault();

    const id = document.getElementById("saleId").value;

    const currencySelect = document.getElementById("currencyId");
    const baseCurrencyOption =
        currencySelect.querySelector('option[data-is-base="1"]');
    const firstCurrencyOption =
        Array.from(currencySelect.options).find(option => option.value !== "");
    const effectiveCurrencyId =
        currencySelect.value ||
        (baseCurrencyOption ? baseCurrencyOption.value : "") ||
        (firstCurrencyOption ? firstCurrencyOption.value : "");

    const payload = {
        customer_id: document.getElementById("customerId").value || null,
        warehouse_id: document.getElementById("warehouseId").value || null,
        customer_invoice_no: document.getElementById("customerInvoiceNo").value,
        invoice_date: document.getElementById("invoiceDate").value,
        currency_id: effectiveCurrencyId || null,
        exchange_rate: Number(document.getElementById("exchangeRate").value || 1),
        payment_method: document.getElementById("paymentMethod").value,
        notes: document.getElementById("notes").value
    };

    try {
        let data;

        if (id) {
            data = await api(`/api/sales/${id}`, {
                method: "PUT",
                body: JSON.stringify(payload)
            });
        } else {
            data = await api("/api/sales", {
                method: "POST",
                body: JSON.stringify(payload)
            });

            document.getElementById("saleId").value = data.sale_id;
            document.getElementById("invoiceNo").value = data.invoice_no;
        }

        showMessage("تم حفظ الفاتورة بنجاح");
        await loadSales();

        if (data.sale_id) {
            await openSale(data.sale_id);
        } else if (id) {
            await openSale(id);
        }

    } catch(e) {
        showMessage(e.message, false);
    }
}

