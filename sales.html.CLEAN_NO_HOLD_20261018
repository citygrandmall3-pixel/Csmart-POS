let saleBarcodeBusy = false;

async function scanSaleBarcode() {
    if (!currentSale || currentSale.status !== "draft") {
        try { await ensurePosDraft(); } catch (e) { setBarcodeMessage("تعذر تجهيز مسودة البيع: " + e.message, false); return; }
    }

    const input = document.getElementById("saleBarcodeInput");

    if (!input) return;

    const barcode = input.value.trim();

    if (!barcode) {
        setBarcodeMessage("أدخل أو امسح الباركود أولًا", false);
        focusSaleBarcode();
        return;
    }

    if (saleBarcodeBusy) {
        return;
    }

    saleBarcodeBusy = true;

    try {
        setBarcodeMessage("جاري البحث...", true);

        const result = await api(
            `/api/product-barcodes/lookup?barcode=${encodeURIComponent(barcode)}`
        );

        if (!result || !result.found || !result.item) {
            throw new Error("الباركود غير معروف");
        }

        const item = result.item;

        const productId = Number(item.product_id);
        const unitId = Number(item.unit_id);

        if (!productId || !unitId) {
            throw new Error("بيانات الصنف أو الوحدة غير مكتملة");
        }

        /*
         * If the product already exists in the invoice with the
         * same unit, increase its quantity instead of adding
         * another line.
         */
        const _sr = stockBalancesCache.find(x => Number(x.product_id) === productId); const _sq = Number(_sr ? _sr.quantity : 0); if (_sq <= 0) { const _pn = (productsCache.find(p => Number(p.id) === productId) || {}).name || productId; throw new Error("لا يوجد رصيد من الصنف " + _pn + " في المخزن الافتراضي."); } const existingItem = Array.isArray(currentSale.items)
            ? currentSale.items.find(existing =>
                Number(existing.product_id) === productId &&
                Number(existing.unit_id) === unitId
            )
            : null;

        if (existingItem) {
            const newQuantity =
                Number(existingItem.quantity || 0) + 1;

            await api(
                `/api/sales/${currentSale.id}/items/${existingItem.id}`,
                {
                    method: "PUT",
                    body: JSON.stringify({
                        product_id: productId,
                        unit_id: unitId,
                        quantity: newQuantity,
                        unit_price: Number(existingItem.unit_price || 0),
                        discount: Number(existingItem.discount || 0),
                        tax_rate: Number(existingItem.tax_rate || 0),
                        notes: existingItem.notes || ""
                    })
                }
            );

            setBarcodeMessage(
                `تمت زيادة كمية "${item.product_name}" إلى ${newQuantity}`,
                true
            );

        } else {
            const priceResult = await getSaleProductPrice(productId, unitId);
            const barcodeSalePrice = Number(priceResult.price || 0);

            await api(
                `/api/sales/${currentSale.id}/items`,
                {
                    method: "POST",
                    body: JSON.stringify({
                        product_id: productId,
                        unit_id: unitId,
                        quantity: 1,
                        unit_price: barcodeSalePrice,
                        discount: 0,
                        tax_rate: 0,
                        notes: ""
                    })
                }
            );

            setBarcodeMessage(
                priceResult.found
                    ? `تمت إضافة "${item.product_name}" — الكمية 1 — السعر ${fmt(barcodeSalePrice)}`
                    : `تمت إضافة "${item.product_name}" بسعر صفر لعدم وجود سعر بيع مسجل لهذه الوحدة والعملة. عدّل السعر قبل اعتماد الفاتورة.`,
                Boolean(priceResult.found)
            );
        }

        /*
         * Refresh invoice data so totals and item rows are current.
         */
        await loadSales();
        await openSale(currentSale.id);

        /*
         * Keep scanner ready for the next barcode.
         */
        const barcodeInput = document.getElementById("saleBarcodeInput");

        if (barcodeInput) {
            barcodeInput.value = "";
        }

        focusSaleBarcode();

    } catch (e) {

        if (e.message === "الباركود غير معروف") { renderProductCatalog(); setBarcodeMessage("", true); return; }
        setBarcodeMessage(
            e.message || "فشل قراءة الباركود",
            false
        );

        const barcodeInput = document.getElementById("saleBarcodeInput");

        if (barcodeInput) {
            barcodeInput.select();
        }

        focusSaleBarcode();
    } finally {
        saleBarcodeBusy = false;
    }
}


function renderProductCatalog() {
    const grid = document.getElementById("productCatalogGrid");
    const input = document.getElementById("saleBarcodeInput");
    const count = document.getElementById("productCatalogCount");
    if (!grid || !input) return;

    const q = input.value.trim().toLocaleLowerCase();
    const matches = productsCache.filter(p =>
        `${p.code || ""} ${p.name || ""}`.toLocaleLowerCase().includes(q)
    );
    const stockByProduct = new Map(stockBalancesCache.map(x => [Number(x.product_id), Number(x.quantity || 0)]));
    matches.sort((a, b) => {
        const aq = stockByProduct.get(Number(a.id)) || 0;
        const bq = stockByProduct.get(Number(b.id)) || 0;
        return Number(bq > 0) - Number(aq > 0) || bq - aq;
    });
    const shown = matches.slice(0, 100);
    if (count) count.textContent = `${matches.length} صنف${matches.length > 100 ? " — عرض أول 100" : ""}`;

    if (!shown.length) {
        grid.innerHTML = '<div class="pos-catalog-empty">لا توجد أصناف مطابقة.</div>';
        return;
    }

    grid.innerHTML = shown.map(p => `
        <button type="button" class="pos-product-card"
                onclick="addCatalogProduct(${Number(p.id)})">
            <span class="pos-product-code">${escapeHtml(p.code || "بدون كود")}</span>
            <strong>${escapeHtml(p.name || "صنف بدون اسم")}</strong>
            <span class="pos-product-unit">${escapeHtml(p.unit_name || p.unit_code || "الوحدة الأساسية")}</span>
            <span class="pos-product-add">＋ إضافة للفاتورة</span>
        </button>
    `).join("");
}

function setCatalogMessage(message, success = true) {
    const el = document.getElementById("productCatalogMessage");
    if (!el) return;
    el.textContent = message || "";
    el.className = success ? "pos-catalog-message success" : "pos-catalog-message error";
