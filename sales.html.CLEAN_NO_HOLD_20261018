async function saveItem() {
    if (!currentSale || currentSale.status !== "draft") return;

    const payload = {
        product_id: Number(document.getElementById("itemProductId").value),
        unit_id: Number(document.getElementById("itemUnitId").value),
        quantity: Number(document.getElementById("itemQuantity").value),
        unit_price: Number(document.getElementById("itemUnitPrice").value),
