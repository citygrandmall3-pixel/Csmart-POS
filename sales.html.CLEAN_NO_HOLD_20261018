                method: "PUT",
                body: JSON.stringify(payload)
            });
            showMessage("تم تعديل الصنف");
        } else {
            await api(`/api/sales/${currentSale.id}/items`, {
                method: "POST",
                body: JSON.stringify(payload)
            });
            showMessage("تم إضافة الصنف");
        }

        cancelItemEdit();
        await loadSales();
        await openSale(currentSale.id);

    } catch(e) {
        showMessage(e.message, false);
    }
}

async function deleteItem(itemId) {
